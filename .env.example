# Engines (defaults: CPU-first parakeet_onnx + sherpa_onnx, no GPU or PyTorch).
#   TRANSCRIPTION_ENGINE = parakeet_onnx | whisperx | mock
#   DIARIZATION_ENGINE   = sherpa_onnx   | pyannote | mock
# pyannote needs requirements-pyannote.txt and HF_TOKEN; whisperx needs requirements-models.txt.
# mock produces FAKE dialogue for UI development only.
TRANSCRIPTION_ENGINE=parakeet_onnx
DIARIZATION_ENGINE=sherpa_onnx
# Optional legacy shorthand: cpu | whisperx | mock. The two settings above win over it.
# ENGINE=
# production refuses a worker with any mock engine.
APP_ENV=development
# CPU engines: ONNX Runtime threads (default: physical cores; on hybrid Intel CPUs
# the performance-core count is often faster), longest Parakeet chunk in seconds,
# and sherpa-onnx clustering threshold (larger -> fewer speakers).
# NUM_THREADS=
MAX_CHUNK_SEC=60
DIARIZATION_THRESHOLD=0.5
# faster-whisper model for TRANSCRIPTION_ENGINE=whisperx.
WHISPER_MODEL=large-v3
# Highest speaker count accepted and used as the auto-detect ceiling.
MAX_SPEAKERS=20
# Worker only: read token after accepting community-1 conditions. Never commit .env.
HF_TOKEN=
# Leave these unset for compose defaults (SQLite shared volume / container Redis).
# Local defaults: sqlite:///./data/jobs.db and redis://127.0.0.1:6379/0.
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/transcripts
# REDIS_URL=redis://127.0.0.1:6379/0
# redis: separate RQ worker (Compose). local: jobs run on a background thread in the
# API process, so native Windows development needs no Redis, Docker, or worker.
QUEUE_BACKEND=redis
# Queue names isolate this app if Redis is shared. Compose uses audio-transcriber.
RQ_QUEUE_NAME=audio-transcriber
# STORAGE_DIR=data/files
# CPU defaults; GPU override selects cuda/float16/batch 4 when unset.
# DEVICE=cpu
# COMPUTE_TYPE=int8
# BATCH_SIZE=2
# Offload loaded weights to CPU between stages to lower GPU use.
FREE_GPU_MEMORY=false
# Defaults: maximum 500 MiB, three hours; ffprobe validates actual content.
MAX_FILE_SIZE_MB=500
MAX_DURATION_SEC=10800
# Delay for each fake inference stage; no actual transcription.
MOCK_DELAY_SEC=1
# Browser origin(s), comma separated.
CORS_ORIGINS=http://localhost:5173
# RQ job execution limit in seconds.
JOB_TIMEOUT_SEC=14400
# Executable names or absolute paths (local dev only; containers include them).
# FFMPEG_BINARY=ffmpeg
# FFPROBE_BINARY=ffprobe
# Vite dev proxy (compose sets http://api:8000).
# API_PROXY_TARGET=http://localhost:8000
# Optional Compose host port if 8000 is occupied; frontend proxy stays internal.
# API_PORT=8000
# FRONTEND_PORT=5173
# Hugging Face model cache (compose sets /models for the worker).
# HF_HOME=/path/to/model-cache
